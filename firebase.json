{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      "node_modules/**",
      "marketing/**",
      "README.md",
      "package.json",
      "package-lock.json",
      "dev-server.js"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/personas",
        "destination": "/solutions",
        "type": 301
      },
      {
        "source": "/proof",
        "destination": "/results",
        "type": 301
      },
      {
        "source": "/games/shift-register-arcade/:page",
        "destination": "/games/intercept-echo/:page",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
